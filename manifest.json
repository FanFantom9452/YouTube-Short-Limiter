{
  "manifest_version": 3,
  "name": "YouTube Shorts 觀看提醒",
  "version": "1.1.0",
  "description": "連續觀看 YouTube Shorts 達設定時間後，跳出全屏提醒並暫停影片。",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "YouTube Shorts 觀看提醒 — 點這裡設定時間",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["tick.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
